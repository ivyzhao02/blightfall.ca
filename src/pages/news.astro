---
import BaseLayout from '../layouts/BaseLayout.astro';
import { newsEntries } from '../content/news';

const publicNews = newsEntries.filter((entry) => entry.approvedForPublication);
---

<BaseLayout
  title="News & Development — BlightFall"
  description="Official studio announcements, BlightFall game updates, and development news."
  canonicalPath="/news/"
>
  <main id="main-content" class="editorial-page">
    <header class="editorial-hero">
      <p class="eyebrow">News & development</p>
      <h1>Dispatches from BlightFall.</h1>
      <p>Official studio announcements and project updates will be collected here.</p>
    </header>

    {
      publicNews.length > 0 ? (
        <section class="news-list" aria-label="Published news">
          {publicNews.map((entry) => (
            <article>
              <p class="eyebrow">{entry.scope}</p>
              <h2>{entry.title}</h2>
              <p>{entry.summary}</p>
            </article>
          ))}
        </section>
      ) : (
        <section class="empty-state" aria-labelledby="empty-heading">
          <p class="eyebrow">Archive opening soon</p>
          <h2 id="empty-heading">No dispatches have been published yet.</h2>
          <p>Until then, follow the official channels for current public updates.</p>
          <a class="text-action" href="/links/">
            Official BlightFall links <span aria-hidden="true">↗</span>
          </a>
        </section>
      )
    }
  </main>
</BaseLayout>
