---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio — BlightFall"
  description="About BlightFall, an independent game studio and development team creating its flagship Roblox RPG."
  canonicalPath="/studio/"
>
  <main id="main-content" class="editorial-page">
    <header class="editorial-hero editorial-hero--atmosphere">
      <img
        class="editorial-hero__backdrop"
        src="/assets/site/studio-atmosphere-1600x900.webp"
        width="1600"
        height="900"
        alt=""
        decoding="async"
        fetchpriority="high"
      />
      <div class="editorial-hero__shade" aria-hidden="true"></div>
      <p class="eyebrow">About the studio</p>
      <h1>Building worlds under one name.</h1>
    </header>

    <section class="editorial-grid" aria-labelledby="identity-heading">
      <div class="section-heading">
        <p class="eyebrow">Studio identity</p>
        <h2 id="identity-heading">BlightFall is the studio and the flagship project.</h2>
      </div>
      <div class="prose-column">
        <p>
          The shared name reflects the project that currently defines the studio’s public identity.
          The studio structure is intentionally broader than a single title, leaving space for
          future games without changing the role of this website.
        </p>
      </div>
    </section>

    <section
      class="editorial-grid editorial-grid--bordered editorial-grid--compact"
      aria-labelledby="current-heading"
    >
      <div class="section-heading">
        <p class="eyebrow">Current focus</p>
        <h2 id="current-heading">The first BlightFall project.</h2>
      </div>
      <div class="prose-column">
        <a class="text-action" href="/projects/blightfall/">
          Explore the project <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
