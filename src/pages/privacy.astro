---
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const analyticsEnabled = siteConfig.analytics.provider !== 'none';
---

<BaseLayout
  title="Privacy — BlightFall"
  description="Privacy information for the official BlightFall website."
  canonicalPath="/privacy/"
>
  <main id="main-content" class="content-page">
    <article class="content-card">
      <p class="eyebrow">Official site</p>
      <h1>Privacy</h1>
      <p>
        This static website does not collect personal information directly or require an account.
      </p>

      <h2>Analytics</h2>
      {
        analyticsEnabled ? (
          <p>
            This site uses {siteConfig.analytics.provider} for aggregate traffic measurement without
            advertising profiles or cross-site tracking.
          </p>
        ) : (
          <p>
            <strong>No analytics service is active.</strong> We do not use advertising trackers,
            fingerprinting, or marketing cookies.
          </p>
        )
      }

      <h2>External links</h2>
      <p>Discord, Roblox, and linked social platforms have their own privacy practices.</p>

      <h2>Discord community statistics</h2>
      <p>
        The News page requests aggregate member and online counts from Discord. It does not request
        usernames. Discord receives standard request information such as your IP address and browser
        details; BlightFall does not receive it.
      </p>

      <h2>Contact by email</h2>
      <p>
        Emailing BlightFall shares your address, message, and attachments with BlightFall and the
        email providers that deliver them. Avoid sending unnecessary sensitive information.
      </p>

      <h2>Changes</h2>
      <p>
        This page will be updated before the site’s data practices materially change. Last reviewed:
        <time datetime="2026-08-17">August 17, 2026</time>.
      </p>
    </article>
  </main>
</BaseLayout>
