---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactRoutes } from '../content/contact';

const mailto = (email: string, subject: string) =>
  `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<BaseLayout
  title="Contact — BlightFall"
  description="Official ways to connect with the independent BlightFall game studio and community."
  canonicalPath="/contact/"
>
  <main id="main-content" class="editorial-page contact-page">
    <header class="editorial-hero">
      <p class="eyebrow">Contact</p>
      <h1>Reach the right inbox.</h1>
      <p>
        Choose the route that best matches your inquiry. General questions can always start with
        hello@blightfall.ca.
      </p>
    </header>

    <section class="contact-directory" aria-label="BlightFall contact email addresses">
      {
        contactRoutes.map((route) => (
          <a
            class:list={['contact-route', route.primary && 'contact-route--primary']}
            href={mailto(route.email, route.subject)}
          >
            <span class="eyebrow">{route.label}</span>
            <strong>{route.email}</strong>
            <span>{route.description}</span>
            <span class="contact-route__action">
              Start an email <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </section>

    <p class="contact-note">
      These links open your email application. This website does not receive or store a message
      before you choose to send it.
    </p>
  </main>
</BaseLayout>
