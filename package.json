{
  "name": "blightfall.ca",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Official website for the independent BlightFall game studio and its flagship Roblox RPG.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "validate:dist": "node scripts/validate-dist.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run validate:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
